{
  "name": "ecosystem-ci-website",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch:history": "node ./scripts/fetch-remote-history.mjs",
    "dev": "pnpm run fetch:history && rs dev",
    "dev:mock": "cross-env RSBUILD_PUBLIC_DATA_SOURCE=mock pnpm run fetch:history && cross-env RSBUILD_PUBLIC_DATA_SOURCE=mock rs dev",
    "dev:cached": "rs dev",
    "build": "pnpm run fetch:history && rs build",
    "preview": "rs preview",
    "verify:ssr": "node scripts/verify-ssr.mjs",
    "deploy": "pnpm build && cf deploy --prebuilt",
    "deploy:prebuilt": "cf deploy --prebuilt"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-virtual": "^3.14.19",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.6.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cf": "1.0.0-beta.28",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.30",
    "rsbuild-plugin-cloudflare": "0.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
