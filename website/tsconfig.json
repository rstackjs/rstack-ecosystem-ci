{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["rstack.config.ts", "postcss.config.cjs", "src"]
}
